# ─── BẢO MẬT: TUYỆT ĐỐI KHÔNG PUSH CÁC KHÓA API VÀ MẬT KHẨU ──────────────────
.env
.env*.local
*.env
backend/.env
frontend/.env.local

# ─── THƯ VIỆN & PHỤ THUỘC (DEPENDENCIES) ───────────────────────────────────────
node_modules/
frontend/node_modules/
vendor/

# ─── BỘ NHỚ ĐỆM & BUILD OUTPUTS ────────────────────────────────────────────────
.next/
frontend/.next/
out/
build/
dist/
*.tsbuildinfo
frontend/*.tsbuildinfo
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# ─── FILE TẠM VÀ DỮ LIỆU ÂM THANH ─────────────────────────────────────────────
storage/temp/*
backend/storage/temp/*
!backend/storage/temp/.gitkeep

# ─── FILE HỆ THỐNG & NHẬT KÝ (LOGS) ────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── CẤU HÌNH IDE ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
